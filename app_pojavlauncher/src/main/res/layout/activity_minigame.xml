<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="@color/background_app">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SUGAR MINIGAMES"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp"/>

    <TextView
        android:id="@+id/minigame_highscore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="High Score: 0"
        android:textSize="16sp"
        android:layout_marginBottom="18dp"/>

    <TextView
        android:id="@+id/minigame_score"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Score: 0   ♥ 3   Combo: 0"
        android:textSize="18sp"
        android:layout_marginBottom="20dp"/>

    <TextView
        android:id="@+id/minigame_target"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SUGAR x3"
        android:textSize="36sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/minigame_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Get ready..."
        android:textSize="17sp"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/minigame_action"
        android:layout_width="220dp"
        android:layout_height="60dp"
        android:text="COLLECT"/>

    <Button
        android:id="@+id/minigame_back"
        android:layout_width="160dp"
        android:layout_height="50dp"
        android:text="BACK"
        android:layout_marginTop="20dp"/>

</LinearLayout>
